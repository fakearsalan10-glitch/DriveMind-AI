st.video(uploaded_video)


# ---------------- PROCESS VIDEO ----------------

if st.button(
    "ðŸš€ START AI ANALYSIS",
    type="primary",
    use_container_width=True,
):
    temp_path = None
    cap = None

    try:
        suffix = os.path.splitext(uploaded_video.name)[1] or ".mp4"

        with tempfile.NamedTemporaryFile(
            delete=False,
            suffix=suffix,
        ) as temp_file:
            temp_file.write(uploaded_video.getvalue())
            temp_path = temp_file.name

        status = st.empty()
        progress = st.progress(0)

        if st.session_state.model is None:
            status.info("Loading pretrained YOLO model...")
            st.session_state.model = YOLO("yolo11n.pt")

        model = st.session_state.model
        cap = cv2.VideoCapture(temp_path)

        if not cap.isOpened():
            st.error("Video open nahi hua. Doosri video try karo.")
            st.stop()

        total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
        fps = cap.get(cv2.CAP_PROP_FPS)

        if not fps or fps <= 0:
            fps = 25.0

        frame_width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
        frame_height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))

        st.caption(
            f"Resolution: {frame_width} Ã— {frame_height} | "
            f"Source FPS: {fps:.1f}"
        )

        video_col, decision_col = st.columns([1.7, 1])

        with video_col:
            st.subheader("AI Vision Feed")
            frame_placeholder = st.empty()

        with decision_col:
            st.subheader("Driving Decision")
            urgency_placeholder = st.empty()
            action_placeholder = st.empty()
            reason_placeholder = st.empty()
            lane_placeholder = st.empty()
            target_placeholder = st.empty()
            side_placeholder = st.empty()

        object_rows = []
        decision_rows = []
        processed_frames = 0
        frame_index = 0
        max_frames = 600
        start_time = time.time()

        while cap.isOpened() and processed_frames < max_frames:
            ok, frame = cap.read()

            if not ok:
                break

            frame_index += 1

            if (frame_index - 1) % frame_step != 0:
                continue

            result = model.track(
                frame,
                persist=True,
                tracker="bytetrack.yaml",
                conf=confidence,
                verbose=False,
            )[0]

            annotated = frame.copy()
            objects = []

            if result.boxes is not None:
                for box in result.boxes:
                    class_id = int(box.cls[0].item())
                    label = model.names.get(class_id, str(class_id))
                    score = float(box.conf[0].item())

                    coords = (
                        box.xyxy[0]
                        .cpu()
                        .numpy()
                        .astype(int)
                    )

                    x1, y1, x2, y2 = coords.tolist()

                    track_id = None
                    if box.id is not None:
                        track_id = int(box.id[0].item())

                    obj = {
                        "Frame": frame_index,
                        "Time (s)": round(frame_index / fps, 2),
                        "Object": label,
                        "Confidence": round(score, 3),
                        "Track ID": (
                            track_id if track_id is not None else "-"
                        ),
                        "Box": (x1, y1, x2, y2),
                    }

                    objects.append(obj)

                    object_rows.append({
                        "Frame": frame_index,
                        "Time (s)": obj["Time (s)"],
                        "Object": label,
                        "Confidence": obj["Confidence"],
                        "Track ID": obj["Track ID"],
                    })

                    if show_boxes:
                        color = (60, 220, 130)

                        if label in VEHICLE_CLASSES:
                            color = (30, 180, 255)

                        cv2.rectangle(
                            annotated,
                            (x1, y1),
                            (x2, y2),
                            color,
                            2,
                        )

                    if show_labels:
                        text_label = f"{label} {score:.0%}"

                        if track_id is not None:
                            text_label += f" ID:{track_id}"

                        cv2.putText(
                            annotated,
                            text_label,
                            (max(4, x1), max(22, y1 - 8)),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.55,
                            (255, 255, 255),
                            2,
                        )

            left_lane, right_lane = detect_lane_markings(frame)

            if show_lane_lines:
                if left_lane:
                    cv2.line(
                        annotated,
                        (left_lane[0], left_lane[1]),
                        (left_lane[2], left_lane[3]),
                        (0, 255, 255),
                        4,
                    )

                if right_lane:
                    cv2.line(
                        annotated,
                        (right_lane[0], right_lane[1]),
                        (right_lane[2], right_lane[3]),
                        (0, 255, 255),
                        4,
                    )

            decision = analyze_driving_situation(
                objects,
                frame_width,
                frame_height,
                left_lane,
                right_lane,
            )

            # Show the current driving recommendation on the video.
            cv2.rectangle(
                annotated,
                (10, 45),
                (min(frame_width - 10, 550), 100),
                (15, 24, 43),
                -1,
            )

            cv2.putText(
                annotated,
                decision["action"],
                (20, 78),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.75,
                (50, 220, 255),
                2,
            )

            rgb_frame = cv2.cvtColor(
                annotated,
                cv2.COLOR_BGR2RGB,
            )

            frame_placeholder.image(
                rgb_frame,
                channels="RGB",
                use_container_width=True,
            )

            if decision["front_obstacle"]:
                urgency_placeholder.error(decision["urgency"])
            elif decision["action"] == "CAUTIOUS APPROACH":
                urgency_placeholder.warning(decision["urgency"])
            else:
                urgency_placeholder.info(decision["urgency"])

            action_placeholder.markdown(
                f"""
                <div class="panel">
                    <div class="small-label">RECOMMENDED ACTION</div>
                    <div class="big-value">{decision["action"]}</div>
                </div>
                """,
                unsafe_allow_html=True,
            )

            reason_placeholder.write(decision["reason"])

            lane_placeholder.markdown(
                f"""
                <div class="panel">
                    <div class="small-label">LANE PERCEPTION</div>
                    <div class="big-value">{decision["lane_status"]}</div>
                </div>
                """,
                unsafe_allow_html=True,
            )

            target_placeholder.markdown(
                f"""
                <div class="panel">
                    <div class="small-label">TARGET / POSITION</div>
                    <div class="big-value">{decision["target"]}</div>
                    <p>{decision["maneuver"]}</p>
                </div>
                """,
                unsafe_allow_html=True,
            )

            side_placeholder.info(decision["side_note"])

            decision_rows.append({
                "Frame": frame_index,
                "Time (s)": round(frame_index / fps, 2),
                "Recommended action": decision["action"],
                "Visual urgency": decision["urgency"],
                "Lane markings": decision["lane_status"],
                "Target position": decision["target"],
                "Front obstacle": decision["front_obstacle"],
                "Left-side detected vehicles": decision["left_zone_vehicles"],
                "Right-side detected vehicles": decision["right_zone_vehicles"],
            })

            processed_frames += 1

            if total_frames > 0:
                progress.progress(
                    min(1.0, frame_index / total_frames)
                )

            status.info(
                f"Frame {frame_index}/{total_frames} | "
                f"Analyzed: {processed_frames}"
            )

        cap.release()
        cap = None

        st.session_state.detections = pd.DataFrame(object_rows)
        st.session_state.decisions = pd.DataFrame(decision_rows)

        elapsed = time.time() - start_time

        status.success(
            f"Analysis complete â€” {processed_frames} frames "
            f"in {elapsed:.1f} seconds."
        )

        m1, m2, m3 = st.columns(3)

        m1.metric("Frames Analyzed", processed_frames)
        m2.metric("Object Detections", len(object_rows))
        m3.metric(
            "Detected Object Types",
            len(set(row["Object"] for row in object_rows)),
        )

        if processed_frames >= max_frames:
            st.warning(
                "600-frame test limit reached. "
                "Use a shorter clip for the initial test."
            )

    except Exception as exc:
        st.error(f"Analysis failed: {exc}")
        st.exception(exc)

    finally:
        if cap is not None:
            cap.release()

        if temp_path and os.path.exists(temp_path):
            try:
                os.remove(temp_path)
            except OSError:
                pass


# ---------------- DOWNLOADABLE REPORTS ----------------

if st.session_state.detections is not None:
    st.divider()
    st.subheader("Object Detection Report")

    detections_df = st.session_state.detections

    if not detections_df.empty:
        counts = (
            detections_df["Object"]
            .value_counts()
            .rename_axis("Object")
            .reset_index(name="Detections")
        )

        st.dataframe(
            counts,
            use_container_width=True,
            hide_index=True,
        )

        with st.expander("View all detections"):
            st.dataframe(
                detections_df,
                use_container_width=True,
                hide_index=True,
            )

        st.download_button(
            "Download Detection CSV",
            detections_df.to_csv(index=False).encode("utf-8"),
            file_name="drivemind_detections.csv",
            mime="text/csv",
        )

if st.session_state.decisions is not None:
    st.subheader("Driving Decision History")

    st.dataframe(
        st.session_state.decisions,
        use_container_width=True,
        hide_index=True,
    )

    st.download_button(
        "Download Driving Decision Report",
        st.session_state.decisions.to_csv(index=False).encode("utf-8"),
        file_name="drivemind_decision_report.csv",
        mime="text/csv",
    )

st.divider()

st.caption(
    "Research prototype only. Lane lines are approximate and may be "
    "incorrect. Visual vehicle size is not calibrated distance or "
    "time-to-collision. Front-camera video cannot establish that an "
    "adjacent lane or blind spot is clear. Do not use recommendations "
    "to control a real vehicle."
)

