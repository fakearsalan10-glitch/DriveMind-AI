# ---------------- LANE DETECTION ----------------

def detect_lane_markings(frame):
    """
    Approximate lane-marking detection using Canny and Hough lines.
    This is a basic visual estimate, not a trained lane segmentation model.
    """
    height, width = frame.shape[:2]

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    blurred = cv2.GaussianBlur(gray, (5, 5), 0)
    edges = cv2.Canny(blurred, 55, 150)

    mask = np.zeros_like(edges)

    polygon = np.array([[
        (int(width * 0.05), height),
        (int(width * 0.42), int(height * 0.48)),
        (int(width * 0.58), int(height * 0.48)),
        (int(width * 0.98), height),
    ]], dtype=np.int32)

    cv2.fillPoly(mask, polygon, 255)
    cropped_edges = cv2.bitwise_and(edges, mask)

    segments = cv2.HoughLinesP(
        cropped_edges,
        rho=1,
        theta=np.pi / 180,
        threshold=35,
        minLineLength=max(25, int(width * 0.035)),
        maxLineGap=80,
    )

    left_lines = []
    right_lines = []

    if segments is not None:
        for segment in segments:
            coords = np.asarray(segment).reshape(-1)

            if coords.size < 4:
                continue

            x1, y1, x2, y2 = map(int, coords[:4])

            dx = x2 - x1
            dy = y2 - y1

            if abs(dx) < 8:
                continue

            slope = dy / dx

            if abs(slope) < 0.35:
                continue

            # In image coordinates, left lane lines normally slope down-left.
            if slope < 0 and (x1 + x2) / 2 < width * 0.60:
                left_lines.append((x1, y1, x2, y2))

            elif slope > 0 and (x1 + x2) / 2 > width * 0.40:
                right_lines.append((x1, y1, x2, y2))

    def average_line(lines):
        if not lines:
            return None

        points = []
        for x1, y1, x2, y2 in lines:
            points.extend([(x1, y1), (x2, y2)])

        points = np.array(points, dtype=np.float32)
        vx, vy, x0, y0 = cv2.fitLine(
            points,
            cv2.DIST_L2,
            0,
            0.01,
            0.01
        ).flatten()

        if abs(vy) < 1e-6:
            return None

        y_bottom = height - 1
        y_top = int(height * 0.52)

        x_bottom = int(x0 + (y_bottom - y0) * vx / vy)
        x_top = int(x0 + (y_top - y0) * vx / vy)

        return (
            max(0, min(width - 1, x_bottom)),
            y_bottom,
            max(0, min(width - 1, x_top)),
            y_top,
        )

    left_line = average_line(left_lines)
    right_line = average_line(right_lines)

    # Reject implausible line positions.
    if left_line and left_line[0] > width * 0.65:
        left_line = None

    if right_line and right_line[0] < width * 0.35:
        right_line = None

    if left_line and right_line:
        if left_line[0] >= right_line[0]:
            left_line = None
            right_line = None

    return left_line, right_line


# ---------------- DRIVING DECISION LOGIC ----------------

VEHICLE_CLASSES = {
    "car", "truck", "bus", "motorcycle"
}

def analyze_driving_situation(
    objects,
    frame_width,
    frame_height,
    left_lane,
    right_lane,
):
    """
    Rule-based visual guidance.
    It does not calculate real-world distance, speed or TTC.
    """

    vehicle_objects = [
        obj for obj in objects
        if obj["Object"] in VEHICLE_CLASSES
    ]

    center_x = frame_width / 2
    front_obstacle = False
    max_front_risk = 0.0
    front_vehicle = None

    left_zone_vehicles = 0
    right_zone_vehicles = 0

    for obj in vehicle_objects:
        x1, y1, x2, y2 = obj["Box"]

        obj_center_x = (x1 + x2) / 2
        obj_center_y = (y1 + y2) / 2

        box_area = max(0, x2 - x1) * max(0, y2 - y1)
        frame_area = max(1, frame_width * frame_height)
        area_ratio = box_area / frame_area

        # Broad screen regions are only rough image-position estimates.
        if obj_center_x < frame_width * 0.38:
            left_zone_vehicles += 1

        if obj_center_x > frame_width * 0.62:
            right_zone_vehicles += 1

        central = abs(obj_center_x - center_x) < frame_width * 0.23
        lower = obj_center_y > frame_height * 0.48

        # Large central/lower vehicle boxes trigger visual caution.
        risk_score = area_ratio * 1000

        if central and lower:
            if risk_score > max_front_risk:
                max_front_risk = risk_score
                front_vehicle = obj

            if area_ratio >= 0.025 or y2 > frame_height * 0.88:
                front_obstacle = True

    lane_count = int(left_lane is not None) + int(right_lane is not None)

    if lane_count == 2:
        lane_status = "Both lane boundaries estimated"
    elif lane_count == 1:
        lane_status = "Only one boundary estimated"
    else:
        lane_status = "Lane boundaries unclear"

    if front_obstacle:
        action = "SLOW DOWN / BRAKE"
        reason = (
            "A large vehicle appears in the central/lower image region. "
            "Reduce speed and maintain control."
        )
        urgency = "HIGH VISUAL CAUTION"

        # Do not declare either adjacent lane safe from a front camera.
        target = "Current lane â€” reduce speed first"
        maneuver = (
            "Do not swerve automatically. Consider a lane change only "
            "after confirming adjacent traffic, markings and blind spots."
        )

    elif front_vehicle is not None:
        action = "CAUTIOUS APPROACH"
        reason = (
            "A vehicle is visible ahead. Its actual distance and closing "
            "speed cannot be determined reliably from this image alone."
        )
        urgency = "MODERATE VISUAL CAUTION"
        target = "Current lane â€” maintain a safe following distance"
        maneuver = (
            "Monitor the vehicle and road. Do not change lanes solely "
            "because a vehicle has been detected."
        )

    else:
        action = "CONTINUE WITH CAUTION"
        reason = (
            "No prominent central/lower vehicle obstacle was identified "
            "in this processed frame."
        )
        urgency = "NO PROMINENT VISUAL ALERT"
        target = "Current lane â€” continue monitoring"
        maneuver = (
            "A clear-looking frame does not prove that the road or "
            "adjacent lanes are safe."
        )

    # Candidate zones are NOT verified lanes. These are only
    # observations about detected vehicles in different image regions.
    if front_obstacle:
        if left_zone_vehicles < right_zone_vehicles:
            candidate = "Left side has fewer detected vehicles"
        elif right_zone_vehicles < left_zone_vehicles:
            candidate = "Right side has fewer detected vehicles"
        else:
            candidate = "No visually preferred side"

        side_note = (
            f"{candidate}. This does NOT mean that side is safe; "
            "the front camera cannot reliably verify blind spots or "
            "rear traffic."
        )
    else:
        side_note = (
            "No lane change is recommended based on this frame alone."
        )

    return {
        "action": action,
        "reason": reason,
        "urgency": urgency,
        "target": target,
        "maneuver": maneuver,
        "lane_status": lane_status,
        "side_note": side_note,
        "front_obstacle": front_obstacle,
        "left_zone_vehicles": left_zone_vehicles,
        "right_zone_vehicles": right_zone_vehicles,
    }


